# ─────────────────────────────────────────────────────────────
# Image generation API keys (server-side only — never commit .env)
# Copy this file to .env and fill in at least ONE free key.
# Priority: gemini → huggingface → xai → pollinations (no key)
# ─────────────────────────────────────────────────────────────

# Optional: force a provider: gemini | huggingface | xai | pollinations
# IMAGE_PROVIDER=gemini

# ── 1) Google Gemini Flash Image (RECOMMENDED free) ──────────
# Get key: https://aistudio.google.com/app/apikey  (no credit card)
# Model: gemini-2.5-flash-image
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── 2) Hugging Face Inference (free monthly credits) ─────────
# Get token: https://huggingface.co/settings/tokens
# Enable "Make calls to Inference Providers" if prompted
HF_TOKEN=
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# ── 3) xAI Grok Imagine (high quality, paid) ─────────────────
# Get key: https://console.x.ai
# Docs: https://docs.x.ai
XAI_API_KEY=
# XAI_IMAGE_MODEL=grok-imagine-image-quality

# ── 4) Pollinations — no key, rate-limited free fallback ─────
# (always available, no env needed)
